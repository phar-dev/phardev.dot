{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "default_agent": "phardev",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "engram": {
      "type": "local",
      "enabled": true,
      "command": [
        "/home/linuxbrew/.linuxbrew/Cellar/engram/1.16.3/bin/engram",
        "mcp",
        "--tools=agent"
      ]
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "oauth": {
        "redirectUri": "https://oc.phardev.site/mcp/oauth/callback?server=notion&directory=%2Fhome%2Fubuntu%2Fworkspace%2Fpersonal%2Fsystem"
      },
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git commit *": "allow",
      "git push *": "ask",
      "git push": "ask",
      "git push --force *": "ask",
      "git rebase *": "ask",
      "git reset --hard *": "ask"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/secrets/**": "deny",
      "**/credentials.json": "deny"
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "agent": {}
}

